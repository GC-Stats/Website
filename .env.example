APP_NAME=Laravel
APP_ENV=local # production in production environment
APP_KEY= # php artisan key:generate
APP_DEBUG=true # False in production
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Identifies which physical server answered the request, shown on the
# legal notice page ("Where am I") for hosting transparency. Set per
# deployment (EU/NA/Oracle), left empty to hide the section.
APP_SERVER_NAME=
APP_SERVER_LOCATION=
APP_SERVER_PROVIDER=
APP_SERVER_ROLE=

INTERNAL_API_SECRET=

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=

# Replication: DB_HOST_WRITE defaults to DB_HOST if unset; DB_HOST_READ accepts
# a comma-separated list of replica hosts and defaults to DB_HOST if unset.
DB_HOST_WRITE=
DB_HOST_READ=
DB_PORT=3306
DB_DATABASE=gc
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Set to bunnycdn in production so all public uploads (logos, emotes, news images) go to Bunny.
FILESYSTEM_DISK_PUBLIC=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MEMCACHED_HOST=127.0.0.1

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=noreply@gc-stats.app
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@gc-stats.app
MAIL_FROM_NAME="${APP_NAME}"

API_KEY_REVEAL_TTL_MINUTES=15

BUNNY_API_KEY=
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_API_KEY=
BUNNY_STORAGE_REGION=
BUNNY_PULL_ZONE_URL=

# Dedicated storage zone for public uploads (logos, emotes, news images) — see FILESYSTEM_DISK_PUBLIC above.
BUNNY_UPLOADS_STORAGE_ZONE=
BUNNY_UPLOADS_API_KEY=
BUNNY_UPLOADS_REGION=
BUNNY_UPLOADS_PULL_ZONE_URL=

VITE_APP_NAME="${APP_NAME}"

HENRIKDEV_API_KEY=

RIOT_KEY=

RIOT_RELAY_URL=
RIOT_RELAY_TOKEN=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_REDIRECT_URI=

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REDIRECT_URI=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MATCH_LIVE_WEBHOOK_URL=

PASSKEYS_USER_HANDLE_SECRET=

GC_STATS_API_URL=http://127.0.0.1:3000
DATA_EXPLORER_QUOTA=100
